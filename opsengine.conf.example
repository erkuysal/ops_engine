# OpsEngine Configuration Example
# Copy this file to 'opsengine.conf' and customize for your project
# You can also run: ./ops.sh init

# ======================
# Project Information
# ======================
PROJECT_NAME="myproject"
PROJECT_TYPE="docker-compose"  # Options: docker-compose, standalone, kubernetes, generic
PROJECT_VERSION="0.1.0"

# ======================
# Project Paths
# ======================
# All paths are relative to the project root (where opsengine.conf is located)
PROJECT_ROOT="."
PROJECT_FRONTEND_PATH="frontend"
PROJECT_BACKEND_PATH="backend"
PROJECT_DESKTOP_PATH="frontend/desktop"
PROJECT_WEB_PATH="frontend/web"

# ======================
# Services Configuration
# ======================
# Comma-separated list of services (used by build, deploy, start scripts)
PROJECT_SERVICES="backend,frontend,worker"

# Service-specific configuration (optional)
# Format: SERVICE_{SERVICE_NAME}_{PROPERTY}
SERVICE_BACKEND_TYPE="django"
SERVICE_BACKEND_PORT="8000"
SERVICE_BACKEND_START_CMD="python manage.py runserver 0.0.0.0:8000"

SERVICE_FRONTEND_TYPE="react"
SERVICE_FRONTEND_PORT="3000"
SERVICE_FRONTEND_START_CMD="npm start"

SERVICE_WORKER_TYPE="celery"
SERVICE_WORKER_PORT=""
SERVICE_WORKER_START_CMD="celery -A myproject worker"

# ======================
# Docker Configuration
# ======================
DOCKER_REGISTRY="dockerhub"  # dockerhub, ghcr.io, or custom registry URL
DOCKER_USERNAME="myusername"
DOCKER_COMPOSE_FILE="docker-compose.yml"
DOCKER_BUILD_CONTEXT="."

# ======================
# Deployment Settings
# ======================
DEPLOY_DOMAIN="example.com"
DEPLOY_IP="192.168.1.100"
DEPLOY_USER="deploy"
DEPLOY_HOST="production-server"
DEPLOY_SSH_KEY="~/.ssh/deploy_key"

# ======================
# Build Settings
# ======================
BUILD_NO_CACHE="false"
BUILD_PUSH="true"
BUILD_PARALLEL="true"

# ======================
# SSL/Certificate Settings
# ======================
CERT_EMAIL="admin@example.com"
CERT_STAGING="false"  # Use Let's Encrypt staging for testing

# ======================
# Updates/Release Settings
# ======================
UPDATES_APP_NAME="myapp"
UPDATES_CHANNEL="stable"  # stable, beta, alpha
UPDATES_HOST="updates.example.com"

# ======================
# CI/CD Settings
# ======================
CI_PROVIDER="github"  # github, gitlab, jenkins
CI_AUTO_DEPLOY="true"
CI_AUTO_TEST="true"

# ======================
# Advanced Settings
# ======================
# Logging
LOG_LEVEL="info"  # debug, info, warning, error
LOG_DIR="logs"

# Backup
BACKUP_ENABLED="true"
BACKUP_DIR="backups"

# Mark as loaded
OPSENGINE_LOADED="true"
