{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ops shipping configuration",
  "type": "object",
  "required": ["version", "pipelines"],
  "properties": {
    "version": { "const": 1 },
    "generated_at": { "type": "string" },
    "source": { "type": "string" },
    "default_pipeline": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "transport": { "enum": ["local", "ssh"] },
          "config_ref": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "pipelines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["jobs"],
        "properties": {
          "description": { "type": "string" },
          "target": { "type": "string" },
          "jobs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "uses"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                "uses": {
                  "enum": ["docker.compose", "files.sync", "git.checkout", "script"]
                },
                "description": { "type": "string" },
                "target": { "type": "string" },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string" },
                  "uniqueItems": true
                },
                "compose_files": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "minItems": 1
                },
                "services": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                },
                "env_files": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "project_directory": { "type": "string" },
                "source": { "type": "string" },
                "destination": { "type": "string" },
                "repository": { "type": "string" },
                "ref": { "type": "string" },
                "transfer": {},
                "build": {},
                "publish": {},
                "deploy": {},
                "verify": {},
                "stages": {
                  "type": "object",
                  "propertyNames": {
                    "enum": ["build", "publish", "transfer", "deploy", "verify"]
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
