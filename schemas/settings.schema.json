{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ops settings",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "type": "integer" },
    "run": {
      "type": "object",
      "properties": {
        "default_mode": { "enum": ["foreground", "background"] }
      }
    },
    "start": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["foreground", "background"] },
        "with_deps": { "type": "boolean" },
        "preview": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "lines": { "type": "integer", "minimum": 0 },
            "wait_seconds": { "type": "integer", "minimum": 0 }
          }
        },
        "healthcheck": {
          "type": "object",
          "properties": {
            "wait": { "type": "boolean" },
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "interval_seconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
