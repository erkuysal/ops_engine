{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ops project setup",
  "type": "object",
  "required": ["version", "project", "services"],
  "properties": {
    "version": { "type": "integer" },
    "project": {
      "type": "object",
      "required": ["name", "default_profile"],
      "properties": {
        "name": { "type": "string" },
        "default_profile": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scaffold": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "package_manager": { "type": "string" },
        "template": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtimes": {
      "type": "object",
      "properties": {
        "python": {
          "type": "object",
          "properties": {
            "manager": { "type": "string" },
            "env": { "type": "string" },
            "fallbacks": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "port": { "type": "integer" },
          "command": { "type": "string" },
          "env_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "runtime": { "type": "string" },
          "role": { "type": "string" },
          "django": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
