{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ops services config",
  "type": "object",
  "required": ["version", "services"],
  "properties": {
    "version": { "const": 1 },
    "generated_at": { "type": "string" },
    "source": { "type": "string" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stack", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "name": { "type": "string" },
          "stack": { "enum": ["django", "elixir-phoenix", "go", "node", "docker", "custom"] },
          "path": { "type": "string" },
          "role": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "runner": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["stack", "process_group", "compose"] }
            },
            "additionalProperties": false
          },
          "build": { "type": "object" },
          "deploy": { "type": "object" },
          "run": { "type": "object" },
          "actions": { "type": "object" },
          "compose_files": { "type": "array", "items": { "type": "string" } },
          "env_files": { "type": "array", "items": { "type": "string" } },
          "env_policy": { "enum": ["dev_file", "ci_system", "mixed"] },
          "env_materialization": { "enum": ["", "none", "symlink", "generated_file"] },
          "env_output_file": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "healthcheck": { "type": "string" },
          "setup": { "type": "object" },
          "meta": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
