{
  "version": 1,
  "run": {
    "default_mode": "foreground"
  },
  "start": {
    "mode": "background",
    "with_deps": true,
    "preview": {
      "enabled": true,
      "lines": 20,
      "wait_seconds": 1
    },
    "healthcheck": {
      "wait": true,
      "timeout_seconds": 60,
      "interval_seconds": 1
    }
  }
}
